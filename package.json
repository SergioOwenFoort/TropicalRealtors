{
  "name": "tropicalrealtors.com",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://SergioOwenFoort.github.io/tropicalrealtors.com",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generateFavicon.mjs",
    "build": "tsc && vite build",
    "build:favicon": "node scripts/generateFavicon.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "deploy:netlify": "npm run build && netlify deploy --prod --dir=dist",
    "deploy:netlify:preview": "npm run build && netlify deploy --dir=dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.55.0",
    "lucide-react": "^0.539.0",
    "dotenv": "^17.2.1",
    "papaparse": "^5.5.3",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^6.0.0",
    "resend": "^6.0.2",
    "save-dev": "^0.0.1-security",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "gh-pages": "^6.3.0",
    "icojs": "^0.19.5",
    "jimp": "^1.6.0",
    "netlify-cli": "^17.0.0",
    "sharp": "^0.33.4",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.0.0",
    "vite": "^7.1.2"
  }
}
