# Backend Environment Variables
# ⚠️ SECURITY: These variables should NEVER be prefixed with VITE_
# Variables with VITE_ prefix are exposed to the client-side code

# =============================================================================
# SUPABASE CONFIGURATION (Backend)
# =============================================================================
# These are for server-side operations only
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# ADMIN CREDENTIALS (Backend Only - NEVER expose to frontend)
# =============================================================================
# ⚠️ CRITICAL: These must NEVER have VITE_ prefix
# Store admin credentials securely in backend environment only
ADMIN_EMAIL=admin@tropicalrealtors.com
ADMIN_PASSWORD=YourSecureAdminPassword123!

# For production, use password hashing:
# ADMIN_PASSWORD_HASH=bcrypt-hash-of-your-password

# =============================================================================
# EMAIL SERVICE (Backend)
# =============================================================================
RESEND_API_KEY=re_your_resend_api_key

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# For Vercel deployment:
# 1. Add these variables in Vercel dashboard → Settings → Environment Variables
# 2. Make sure they are NOT prefixed with VITE_
# 3. Mark them as "Server-side only" in Vercel settings
#
# For local development:
# 1. Create a .env.local file with these variables
# 2. Add .env.local to .gitignore
# 3. Never commit this file to version control
#
# For other hosting platforms:
# 1. Consult their documentation for setting environment variables
# 2. Ensure backend variables are not exposed to client

# =============================================================================
# SECURITY CHECKLIST
# =============================================================================
# ✅ No VITE_ prefix on sensitive variables
# ✅ Backend environment variables not committed to Git
# ✅ Service role key only used in backend
# ✅ Admin credentials only in backend
# ✅ Production uses password hashing (bcrypt recommended)
