# Supabase configuration - Required for the app to function
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXItcHJvamVjdC1pZCIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNjMwMDAwMDAwLCJleHAiOjE5NDUwMDAwMDB9.your-actual-key
# Do not put service role key in Vite env files. Use server-only env.

# ⚠️ SECURITY: Admin credentials REMOVED from frontend environment
# Admin authentication now handled by backend API only
# Configure admin credentials in backend environment variables:
# - ADMIN_EMAIL (backend only, no VITE_ prefix)
# - ADMIN_PASSWORD (backend only, no VITE_ prefix)
# See .env.backend.example for backend configuration

# Email service (Resend.com) - Required for password reset and notifications
VITE_RESEND_API_KEY=re_123456789

# Webhook Configuration - Optional for webhook integrations
VITE_WEBHOOK_SECRET=your_webhook_secret_here

# API Configuration - Optional for external API integrations
VITE_API_URL=http://localhost:3000
VITE_API_KEY=your_api_key_here

# Google Maps API Key for geocoding and maps
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable Geocoding API and Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# hCaptcha Configuration - Required for security and spam protection
# Get your keys from: https://dashboard.hcaptcha.com/
# 1. Create a free account at hCaptcha.com
# 2. Add your domain in the dashboard
# 3. Copy the Site Key (used in frontend) and Secret Key (used for verification)
VITE_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key_here
VITE_HCAPTCHA_SECRET_KEY=your_hcaptcha_secret_key_here

# Other Configuration
VITE_ALLOWED_ORIGIN=https://bonairemakelaars.com
VITE_DOMAIN=bonairemakelaars.com
PORT=3000
